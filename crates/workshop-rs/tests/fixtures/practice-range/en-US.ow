rule ("Cover actions 60: Global Variable At Rate") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.rangeCase == 60;
    }
    actions {
        Chase Global Variable At Rate(probe, 0, 1, None);
        Chase Global Variable Over Time(probe, 0, 1, None);
        Chase Player Variable At Rate(Event Player, probe_p, 0, 1, None);
        Chase Player Variable Over Time(Event Player, probe_p, 0, 1, None);
        Set Invisible(Event Player, All);
        Wait Until(True, 1);
        Skip(1);
        Modify Global Variable(probe, Append To Array, 0);
        Start Game Mode;
        Set Player Allowed Heroes(Event Player, Hero(D.Va));
        Set Secondary Fire Enabled(Event Player, True);
        Destroy All Progress Bar HUD Text;
        Destroy All Progress Bar In-World Text;
        Abort;
        Set Jump Vertical Speed(Event Player, 1);
        Set Reload Enabled(Event Player, True);
        Set Weapon(Event Player, 1);
        Stop All Heal Over Time(Event Player);
        For Player Variable(Event Player, probe_p, 1, 1, 1);
        Wait(1, Ignore Condition);
        End;
        Continue;
    }
}


