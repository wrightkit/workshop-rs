variables {
    global:
        0: rangeCase
        1: probe
    player:
        0: probe_p
}


subroutines {
    0: sub
}


rule ("Cover actions 0: Icon") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.rangeCase == 0;
    }
    actions {
        Create Icon(Event Player, Vector(0, 1, 0), No, Visible To and Position, Color(Yellow), True);
        Destroy Icon(Last Created Entity);
    }
}


rule ("Cover actions 1: Forcing Player Outline") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.rangeCase == 1;
    }
    actions {
        Start Forcing Player Outlines(Event Player, Event Player, True, Color(Yellow), Always);
        Stop Forcing Player Outlines(Event Player, Event Player);
    }
}


rule ("Cover actions 2: Forcing Spawn Room") {
