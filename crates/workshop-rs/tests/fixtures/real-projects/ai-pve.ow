            在索引处设置玩家变量(事件玩家, shion_buff, 3, 0);
            循环;
        Else;
            在索引处设置玩家变量(事件玩家, shion_buff, 0, 0);
            在索引处设置玩家变量(事件玩家, shion_buff, 3, 0);
