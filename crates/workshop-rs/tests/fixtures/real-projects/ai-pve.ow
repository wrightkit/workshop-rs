    }
    动作 {
        在索引处设置玩家变量(事件玩家, shion_buff, 3, 首个((事件玩家).shion_buff));
        等待(2, 无视条件);
        If(或(或(死亡(事件玩家), 比较(首个((事件玩家).reset_pvar), !=, 假)), 比较(数组中的值((事件玩家).shion_buff, 2), ==, 真)));
