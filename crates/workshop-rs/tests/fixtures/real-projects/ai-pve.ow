规则 ("[utilities/reset.opy]: resetStatuses()") {
    事件 {
        子程序;
        resetStatuses;
    }
    动作 {
        停止所有持续伤害(事件玩家);
        停止限制阈值(事件玩家);
        在索引处设置玩家变量(事件玩家, freja_buff, 0, 0);
        在索引处设置玩家变量(事件玩家, freja_buff, 1, 0);
        调用子程序(clearMoveSpeedDebuffs);
        设置玩家变量(事件玩家, taunt, 假);
        清除状态(事件玩家, 沉睡);
        清除状态(事件玩家, 燃烧);
        清除状态(事件玩家, 冰冻);
        清除状态(事件玩家, 被入侵);
        清除状态(事件玩家, 无敌);
        清除状态(事件玩家, 击倒);
        清除状态(事件玩家, 相移);
        清除状态(事件玩家, 定身);
        清除状态(事件玩家, 击晕);
        清除状态(事件玩家, 无法杀死);
    }
}

