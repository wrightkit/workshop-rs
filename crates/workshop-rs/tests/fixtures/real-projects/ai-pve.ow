规则 ("[reset.opy]: Reinitialize hero on new round") {
    事件 {
        持续 - 每名玩家;
        双方;
        全部;
    }
    条件 {
        处于回合之间 == 真;
        所用英雄(事件玩家) != 英雄(黑影);
    }
    动作 {
        "Spread engine-facing cleanup across frames instead of running it for\nevery player in the same transition tick (one server frame per slot)."
        等待(乘(栏位(事件玩家), 0.016), 无视条件);
        在索引处设置玩家变量(事件玩家, reset_pvar, 10, 真);
        调用子程序(resetBetweenRounds);
        等待直到 (非(处于回合之间), 999999999999);
        等待(加(乘(栏位(事件玩家), 10), 0.25), 无视条件);
        If(比较(数组中的值((事件玩家).reset_pvar, 10), ==, 真));
            在索引处设置玩家变量(事件玩家, hero_switch_pvar, 2, 所用英雄(事件玩家));
            在索引处设置玩家变量(事件玩家, hero_switch_pvar, 1, 真);
            在索引处设置玩家变量(事件玩家, reset_pvar, 0, 真);
            记入查看器(自定义字符串("queued init after new round (main throttled)"));
    }
}

规则 ("[utilities/reset.opy]: resetBetweenRounds()") {
    事件 {
        子程序;
        resetBetweenRounds;
    }
    动作 {
        "Narrow between-round cleanup: only state that must not survive the round\nboundary. Hero-local counters that resetHero() re-derives are deferred to\nthe (staggered) re-init so the full hero-reset path runs once per round."
        停止所有持续伤害(事件玩家);
        停止限制阈值(事件玩家);
        调用子程序(clearMoveSpeedDebuffs);
        在索引处设置玩家变量(事件玩家, freja_buff, 0, 0);
        在索引处设置玩家变量(事件玩家, freja_buff, 1, 0);
        设置玩家变量(事件玩家, has_nano, 假);
        在索引处设置玩家变量(事件玩家, zarya_buff, 0, 真);
        在索引处设置玩家变量(事件玩家, zarya_buff, 1, 空);
        设置玩家变量(事件玩家, doom_buff, 0);
        清除状态(事件玩家, 沉睡);
        清除状态(事件玩家, 燃烧);
        清除状态(事件玩家, 冰冻);
        清除状态(事件玩家, 被入侵);
        清除状态(事件玩家, 无敌);
        清除状态(事件玩家, 击倒);
        清除状态(事件玩家, 相移);
        清除状态(事件玩家, 定身);
        清除状态(事件玩家, 击晕);
        清除状态(事件玩家, 无法杀死);
    }
}

