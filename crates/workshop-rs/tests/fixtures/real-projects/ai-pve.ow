规则 ("[Global]Setup Blacklist") {
    事件 {
        持续 - 全局;
    }
    动作 {
        设置全局变量(Blacklist, 空数组);
        等待(0.25, 无视条件);
        修改全局变量(Blacklist, 添加至数组, 字符串分割(自定义字符串("哇哦谢谢你-浅眉-丶基猫-蜡笔小新眼子-Patrick-蟑螂恶霸-哈奇-翻斗花园胡图图-心有猛虎-亞当-我要去美国了-无月-念安-浑沌-爱喝芒果汁"), 自定义字符串("-")));
        修改全局变量(Blacklist, 添加至数组, 字符串分割(自定义字符串("为这点事活着吗-她与春风皆过客-Eliake-李幽州-LETSGODUDE-嗣音-河神与樵夫的交易-qing-Gastby-暴躁的快速玩家-Azuki9527-李慕下"), 自定义字符串("-")));
        修改全局变量(Blacklist, 添加至数组, 字符串分割(自定义字符串("小哲-比奇堡悍匪-蓝海-啊哈哈哈哈-EdwardJoe-EQUA-小余天天开心-梦想成为源氏糕手-口执剑只为伊人口-折耳-必深深李雪花大姨-乌有-贝壳"), 自定义字符串("-")));
        修改全局变量(Blacklist, 添加至数组, 字符串分割(自定义字符串("假如给我三天雨姐-YyX-挽风-太酱樱铃-笙墨-秘泽-高大的死灵-大魔王皮平1-两毛五-Robotman-三十三岁上班族-土豆焖马铃薯-Freakybab"), 自定义字符串("-")));
        修改全局变量(Blacklist, 添加至数组, 字符串分割(自定义字符串("膨胀的魔丸-坦诚的巨鹰-我可能喝了假奶-我可能喝了假白酒-陆陆好公路收费站-炉火糖粥-一曲柳暗花-王中王鱿鱼火腿肠-蒙牛牌特仑苏-魔王献捷"), 自定义字符串("-")));
    }
}

规则 ("[Player]Remove Player from Blacklist") {
    事件 {
        玩家加入比赛;
        双方;
        全部;
    }
    条件 {
        数组包含(全局.Blacklist, 自定义字符串("{0}", 事件玩家)) == 真;
    }
    动作 {
        移除玩家(事件玩家);
    }
}

