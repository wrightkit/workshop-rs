规则 ("[hero_init/dispatcher.opy]: initialize hero") {
    事件 {
        持续 - 每名玩家;
        双方;
        全部;
    }
    条件 {
        数组中的值((事件玩家).hero_switch_pvar, 1) == 真;
        已重生(事件玩家) == 真;
        首个((事件玩家).reset_pvar) != 假;
        所用英雄(事件玩家) == 数组中的值((事件玩家).hero_switch_pvar, 2);
    }
    动作 {
        调用子程序(resetHero);
        调用子程序(heroInitDispatcher);
        在索引处设置玩家变量(事件玩家, hero_switch_pvar, 0, 数组中的值((事件玩家).hero_switch_pvar, 2));
        在索引处设置玩家变量(事件玩家, hero_switch_pvar, 1, 假);
        在索引处设置玩家变量(事件玩家, reset_pvar, 0, 假);
        在索引处设置玩家变量(事件玩家, reset_pvar, 10, 假);
    }
}

