变量 {
    全局:
        0: probe
        1: t
}

规则 ("slot acceptance: combined") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(1, 无视条件);
        设置全局变量(t, 7);
        记入查看器(自定义字符串("SA1 control={0}", 截取字符串(自定义字符串("abcdef"), 1, 2), 空, 空));
        记入查看器(自定义字符串("SA2 number_literal={0}", 截取字符串(100, 1, 2), 空, 空));
        记入查看器(自定义字符串("SA3 number_expression={0}", 截取字符串(加(余数(全局.t, 60), 100), 1, 2), 空, 空));
        记入查看器(自定义字符串("SA4 vector={0}", 截取字符串(矢量(1, 2, 3), 1, 2), 空, 空));
        记入查看器(自定义字符串("SA5 player={0}", 截取字符串(主机玩家, 1, 2), 空, 空));
        记入查看器(自定义字符串("SA6 square_root_player={0}", 平方根(主机玩家), 空, 空));
        记入查看器(自定义字符串("SA done", 空, 空, 空));
    }
}
