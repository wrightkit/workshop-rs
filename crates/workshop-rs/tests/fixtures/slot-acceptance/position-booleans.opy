globalvar g

rule "r":
    @Event eachPlayer
    createEffect(getAllPlayers(), Effect.SPHERE, Color.LIGHT_RED, false, 1, EffectReeval.VISIBILITY_POSITION_RADIUS_AND_COLOR)
    createEffect(getAllPlayers(), Effect.SPHERE, Color.LIGHT_RED, true, 1, EffectReeval.VISIBILITY_POSITION_RADIUS_AND_COLOR)
    playEffect(getAllPlayers(), DynamicEffect.BAD_EXPLOSION, Color.LIGHT_RED, false, 1)
    playEffect(getAllPlayers(), DynamicEffect.BAD_EXPLOSION, Color.LIGHT_RED, true, 1)
    createIcon(getAllPlayers(), false, Icon.FLAG, IconReeval.VISIBILITY_AND_POSITION, Color.LIGHT_RED, true)
    createIcon(getAllPlayers(), true, Icon.FLAG, IconReeval.VISIBILITY_AND_POSITION, Color.LIGHT_RED, true)
    createInWorldText(getAllPlayers(), "a", false, 1, Clip.NONE, WorldTextReeval.VISIBILITY_POSITION_AND_STRING, Color.LIGHT_RED, SpecVisibility.DEFAULT)
    createInWorldText(getAllPlayers(), "a", true, 1, Clip.NONE, WorldTextReeval.VISIBILITY_POSITION_AND_STRING, Color.LIGHT_RED, SpecVisibility.DEFAULT)
    createProgressBarInWorldText(getAllPlayers(), 1, "a", false, 1, Clip.NONE, Color.LIGHT_RED, Color.LIGHT_RED, ProgressWorldTextReeval.VISIBILITY_POSITION_AND_COLOR, SpecVisibility.DEFAULT)
    createProgressBarInWorldText(getAllPlayers(), 1, "a", true, 1, Clip.NONE, Color.LIGHT_RED, Color.LIGHT_RED, ProgressWorldTextReeval.VISIBILITY_POSITION_AND_COLOR, SpecVisibility.DEFAULT)
    createProjectileEffect(getAllPlayers(), Projectile.ROADHOG_SCRAP, eventPlayer, false, Vector.UP, 1, ProjectileEffectReeval.VISIBILITY_POSITION_DIRECTION_AND_SIZE)
    createProjectileEffect(getAllPlayers(), Projectile.ROADHOG_SCRAP, eventPlayer, true, Vector.UP, 1, ProjectileEffectReeval.VISIBILITY_POSITION_DIRECTION_AND_SIZE)
    g = isInLoS(false, eventPlayer)
    g = isInLoS(true, eventPlayer)
    g = isInLoS(eventPlayer, false)
    g = isInLoS(eventPlayer, true)
    g = distance(false, eventPlayer)
    g = distance(true, eventPlayer)
    g = distance(eventPlayer, false)
    g = distance(eventPlayer, true)
    g = directionTowards(false, eventPlayer)
    g = directionTowards(true, eventPlayer)
    g = directionTowards(eventPlayer, false)
    g = directionTowards(eventPlayer, true)
    g = getPlayersInRadius(false, 1, Team.ALL, LosCheck.OFF)
    g = getPlayersInRadius(true, 1, Team.ALL, LosCheck.OFF)
    g = getClosestPlayer(false, Team.ALL)
    g = getClosestPlayer(true, Team.ALL)
    g = horizontalAngleTowards(eventPlayer, false)
    g = horizontalAngleTowards(eventPlayer, true)
