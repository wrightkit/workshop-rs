变量
{
	全局:
		1: t
}

规则("slot acceptance: combined")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(1, 无视条件);
		全局.t = 7;
		记入查看器(自定义字符串("SA1 control={0}", 截取字符串(自定义字符串("abcdef"), 1, 2)));
		记入查看器(自定义字符串("SA3 number_expression={0}", 截取字符串(全局.t % 60 + 100, 1, 2)));
		记入查看器(自定义字符串("SA5 player={0}", 截取字符串(主机玩家, 1, 2)));
		记入查看器(自定义字符串("SA6 square_root_player={0}", 平方根(主机玩家)));
		记入查看器(自定义字符串("SA done"));
	}
}
