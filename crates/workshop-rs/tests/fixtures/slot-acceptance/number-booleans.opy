globalvar g

rule "r":
    @Event eachPlayer
    g = rgb(255, 128, false)
    eventPlayer.setDamageDealt(false)
    g = directionFromAngles(false, 90)
    g = rgb(255, 128, true)
    eventPlayer.setDamageDealt(true)
    g = directionFromAngles(true, 90)
    g = rgb(false, 128, 255)
    g = rgb(true, 128, 255)
    g = rgb(255, false, 128)
    g = rgb(255, true, 128)
    g = rgb(255, 128, 64, false)
    g = rgb(255, 128, 64, true)
    g = directionFromAngles(45, false)
    g = directionFromAngles(45, true)
    eventPlayer.setDamageReceived(false)
    eventPlayer.setDamageReceived(true)
    eventPlayer.setKnockbackReceived(false)
    eventPlayer.setKnockbackReceived(true)
    startDamageModification(eventPlayer, eventPlayer, false, DamageReeval.NONE)
    startDamageModification(eventPlayer, eventPlayer, true, DamageReeval.NONE)
    eventPlayer.startThrottleInDirection(Vector.UP, false, Relativity.TO_WORLD, Throttle.REPLACE_EXISTING, ThrottleReeval.NONE)
    eventPlayer.startThrottleInDirection(Vector.UP, true, Relativity.TO_WORLD, Throttle.REPLACE_EXISTING, ThrottleReeval.NONE)
    g = eventPlayer.isInViewAngle(vect(1, 2, 3), false)
    g = eventPlayer.isInViewAngle(vect(1, 2, 3), true)
    playEffect(getAllPlayers(), DynamicEffect.BAD_EXPLOSION, Color.RED, eventPlayer, false)
    playEffect(getAllPlayers(), DynamicEffect.BAD_EXPLOSION, Color.RED, eventPlayer, true)
